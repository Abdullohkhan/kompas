# Copy to .env (never commit .env). On Railway set these as service variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"   # Railway: reference ${{Postgres.DATABASE_URL}}
JWT_SECRET=""            # required, >= 32 chars. Generate: openssl rand -hex 32
JWT_EXPIRES_IN="7d"
PORT=4000                # Railway sets PORT itself
CORS_ORIGIN=""           # optional; not needed when the frontend proxies /api (default setup)
ALLOW_REGISTRATION="true" # set "false" in production once the admin exists
# Seed only (npm run db:seed):
SEED_ADMIN_EMAIL="demo@example.com"
SEED_ADMIN_PASSWORD=""   # required for seeding, >= 8 chars
SEED_DEMO_DATA="true"    # "false" = create only the admin user
